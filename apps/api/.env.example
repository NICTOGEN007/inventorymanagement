# Copy this file to .env and adjust as needed.
NODE_ENV=development
PORT=4000
# Transactions need a replica set; `docker compose up mongo` starts one at this address.
MONGODB_URI=mongodb://localhost:27017/inventory?replicaSet=rs0&directConnection=true
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Secret for signing access tokens (required in production). Generate one with:
#   openssl rand -hex 32
# JWT_ACCESS_SECRET=
# Access token lifetime in seconds, and how long a login lasts without activity (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie over HTTPS only; defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
