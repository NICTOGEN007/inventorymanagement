{
  "name": "@ims/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API: Express 5 + MongoDB (Mongoose)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
